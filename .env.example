MYSQL_DATABASE=odds
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SOCKET=/tmp/mysql.sock
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_TLS=true
# MYSQL_CA_PEM=

# Set both values on the server (locally in .env, and in Vercel).
# Generate independent random values with: openssl rand -hex 32
ODDS_PASSWORD=
ODDS_SESSION_SECRET=

# Calendrier football de jour2foot (clé côté serveur)
RAPIDAPI_KEY=

# Appels externes désactivés par défaut. Réactiver après vérification du quota.
FOOTAPI_ENABLED=false
# Maximum par chargement. Un échec reste en cache pour la journée.
FOOTAPI_MAX_CALLS=10
